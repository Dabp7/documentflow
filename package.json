{
  "name": "documentflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "api": "tsx apps/api/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --maxWorkers=1 --no-file-parallelism",
    "test:e2e": "tsx tests/e2e/run.ts",
    "verify": "npm run build && npm test && npm run test:integration",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "demo:failure": "tsx scripts/demo-failure.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "express": "5.3.0",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "puppeteer": "25.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.11",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "3.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "playwright": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "yauzl": "3.4.0"
  }
}
